{
  "item": "MTN PostgreSQL",
  "code": "PoSQLINST01",
  "read": "2026-10-31",
  "fields": [
    {
      "name": "autoSecurityUpdates",
      "label": "AUTO SECURITY UPDATES",
      "type": "checkbox"
    },
    {
      "name": "cloud",
      "label": "CLOUD",
      "type": "cloud",
      "required": true
    },
    {
      "name": "dbName",
      "label": "DATABASE NAME",
      "type": "text",
      "pattern": "(?i)^[a-z_][a-z0-9_\\$]{0,62}$",
      "example": "mydb"
    },
    {
      "name": "dbPassword",
      "label": "DB PASSWORD",
      "type": "password",
      "example": "root123"
    },
    {
      "name": "dbUsername",
      "label": "DB USERNAME",
      "type": "text",
      "pattern": "(?i)^[a-z_][a-z0-9_\\$]{0,62}$",
      "example": "dbuser"
    },
    {
      "name": "environment",
      "label": "ENVIRONMENT",
      "type": "environment"
    },
    {
      "name": "floatingip",
      "label": "FLOATING IP",
      "type": "select",
      "choices": [
        "public-network-01",
        "public-network-02",
        "public-network-03",
        "public-network-04"
      ]
    },
    {
      "name": "group-vpn",
      "label": "GROUP",
      "type": "group",
      "required": true
    },
    {
      "name": "hostCIDRs",
      "label": "ALLOWABLE HOST CIDR",
      "type": "textarea",
      "required": true,
      "default": "0.0.0.0/0",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})/(3[0-2]|[12]?[0-9])(,\\s*((25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})/(3[0-2]|[12]?[0-9]))*$",
      "example": "10.60.50.0/24, 10.60.40.0/24",
      "help": "Comma seperated list of clients that can connect with the DB"
    },
    {
      "name": "labels",
      "label": "LABELS",
      "type": "textArray",
      "help": "Enter a comma-separated list of labels to group and categorise items for easier filtering in list views."
    },
    {
      "name": "makeUserDbOwner",
      "label": "MAKE DB OWNER? If checked, user created will be DB Owner.",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "name",
      "label": "NAME",
      "type": "text",
      "required": true,
      "default": "${userInitials}-${accountId}-MTN-CLOUD-${type}-${sequence+0}"
    },
    {
      "name": "networks",
      "label": "NETWORKS",
      "type": "networkManager",
      "required": true
    },
    {
      "name": "passwordExpiryDays",
      "label": "PASSWORD EXPIRY DAYS",
      "type": "number",
      "example": "1"
    },
    {
      "name": "pgVersion",
      "label": "POSTGRES VERSION",
      "type": "select",
      "no_blank": true,
      "default": "17",
      "choices": [
        "18",
        "17",
        "16",
        "15"
      ]
    },
    {
      "name": "plan",
      "label": "PLAN",
      "type": "select",
      "required": true
    },
    {
      "name": "requireSSL",
      "label": "REQUIRE SSL FOR CONNECTIONS?",
      "type": "checkbox"
    },
    {
      "name": "resourcepool",
      "label": "RESOURCE POOL",
      "type": "resourcePool",
      "required": true
    },
    {
      "name": "securitygroups",
      "label": "SECURITY GROUP(s)",
      "type": "secGroup"
    },
    {
      "name": "useHostSSL",
      "label": "USE HOSTSSL? If checked host CIDRs will be inputed as 'hostssl'",
      "type": "checkbox"
    },
    {
      "name": "volumes",
      "label": "VOLUMES",
      "type": "diskManager",
      "required": true
    }
  ]
}
