{
  "item": "MTN Managed Database",
  "code": "MDBS001",
  "read": "2026-10-31",
  "fields": [
    {
      "name": "adminPassword",
      "label": "ADMIN PASSWORD",
      "type": "password",
      "required": true,
      "example": "********",
      "help": "Password for the global administrator."
    },
    {
      "name": "adminUsername",
      "label": "ADMIN USERNAME",
      "type": "text",
      "required": true,
      "default": "admin",
      "pattern": "(?i)^[a-z_][a-z0-9_\\$]{0,62}$",
      "example": "Admin",
      "help": "Username for the global administrator"
    },
    {
      "name": "cloud",
      "label": "CLOUD",
      "type": "cloud",
      "required": true
    },
    {
      "name": "db_engine",
      "label": "DATABASE ENGINE",
      "type": "select",
      "required": true,
      "help": "Select your preferred database engine.",
      "choices": [
        "PostgreSQL",
        "MySQL"
      ]
    },
    {
      "name": "environment",
      "label": "ENVIRONMENT",
      "type": "environment"
    },
    {
      "name": "floatingip",
      "label": "FLOATING IP",
      "type": "select",
      "hidden": true,
      "choices": [
        "public-network-01",
        "public-network-02",
        "public-network-03",
        "public-network-04"
      ]
    },
    {
      "name": "group-vpn",
      "label": "GROUP",
      "type": "group",
      "required": true
    },
    {
      "name": "labels",
      "label": "LABELS",
      "type": "textArray",
      "help": "Enter a comma-separated list of labels to group and categorise items for easier filtering in list views."
    },
    {
      "name": "mysqlVersion",
      "label": "MYSQL VERSION",
      "type": "select",
      "no_blank": true,
      "shown_when": "db_engine:mysql",
      "choices": [
        "8.4 LTS",
        "8.0"
      ]
    },
    {
      "name": "name",
      "label": "NAME",
      "type": "text",
      "required": true,
      "example": "Prod Database",
      "help": "Name of Service."
    },
    {
      "name": "networks",
      "label": "NETWORKS",
      "type": "networkManager",
      "required": true
    },
    {
      "name": "no_nodes",
      "label": "NO. OF NODES",
      "type": "number",
      "default": "1",
      "example": "1",
      "min": 1,
      "max": 3,
      "help": "For multi‑node deployments, one node acts as the primary (handling both reads and writes), while the remaining nodes function as read replicas. If the primary node fails, replicas can be promoted to take over as the new primary. Note: A 2-node cluster is not supported"
    },
    {
      "name": "pgVersion",
      "label": "POSTGRES VERSION",
      "type": "select",
      "no_blank": true,
      "shown_when": "db_engine:postgres",
      "choices": [
        "18",
        "17",
        "16",
        "15"
      ]
    },
    {
      "name": "plan",
      "label": "PLAN",
      "type": "select",
      "required": true
    },
    {
      "name": "resourcepool",
      "label": "RESOURCE POOL",
      "type": "resourcePool",
      "required": true
    },
    {
      "name": "securitygroups",
      "label": "SECURITY GROUP(s)",
      "type": "secGroup",
      "required": true
    },
    {
      "name": "volumes",
      "label": "VOLUMES",
      "type": "diskManager",
      "required": true
    }
  ]
}
