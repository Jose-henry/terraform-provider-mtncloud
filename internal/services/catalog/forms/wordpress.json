{
  "item": "MTN WordPress",
  "code": "wordpres010",
  "read": "2026-10-31",
  "fields": [
    {
      "name": "autoSecurityUpdates",
      "label": "AUTO SECURITY UPDATES",
      "type": "checkbox"
    },
    {
      "name": "cloud",
      "label": "CLOUD",
      "type": "cloud",
      "required": true
    },
    {
      "name": "dbName",
      "label": "DATABASE NAME",
      "type": "text",
      "required": true,
      "pattern": "(?i)^[a-z_][a-z0-9_\\$]{0,62}$",
      "example": "mydb"
    },
    {
      "name": "dbPassword",
      "label": "DB PASSWORD",
      "type": "password",
      "required": true,
      "example": "root123"
    },
    {
      "name": "dbUsername",
      "label": "DB USERNAME",
      "type": "text",
      "required": true,
      "pattern": "(?i)^[a-z_][a-z0-9_\\$]{0,62}$",
      "example": "dbuser"
    },
    {
      "name": "environment",
      "label": "ENVIRONMENT",
      "type": "environment"
    },
    {
      "name": "floatingip",
      "label": "FLOATING IP",
      "type": "select",
      "required": true,
      "choices": [
        "public-network-01",
        "public-network-02",
        "public-network-03",
        "public-network-04"
      ]
    },
    {
      "name": "group-vpn",
      "label": "GROUP",
      "type": "group",
      "required": true
    },
    {
      "name": "hostCIDRs",
      "label": "ALLOWABLE HOST CIDR",
      "type": "textarea",
      "required": true,
      "default": "0.0.0.0/0",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})/(3[0-2]|[12]?[0-9])(,\\s*((25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})/(3[0-2]|[12]?[0-9]))*$",
      "example": "10.60.50.0/24, 10.60.40.0/24",
      "help": "Comma seperated list of clients that can connect with the DB"
    },
    {
      "name": "labels",
      "label": "LABELS",
      "type": "textArray",
      "help": "Enter a comma-separated list of labels to group and categorise items for easier filtering in list views."
    },
    {
      "name": "makeUserDbOwner",
      "label": "MAKE DB OWNER? If checked, user created will be DB Owner",
      "type": "checkbox",
      "required": true,
      "locked": true,
      "default": "true"
    },
    {
      "name": "mysqlVersion",
      "label": "MYSQL VERSION",
      "type": "select",
      "no_blank": true,
      "choices": [
        "8.4 LTS",
        "8.0"
      ]
    },
    {
      "name": "name",
      "label": "NAME",
      "type": "text",
      "required": true,
      "default": "${userInitials}-${accountId}-MTN-CLOUD-${type}-${sequence+0}"
    },
    {
      "name": "networks",
      "label": "NETWORKS",
      "type": "networkManager",
      "required": true
    },
    {
      "name": "php_memory_limit",
      "label": "PHP MEMORY LIMIT",
      "type": "select",
      "required": true,
      "no_blank": true,
      "default": "512M (Recommended)",
      "help": "Limits how much RAM a single script can consume.",
      "choices": [
        "128M",
        "256M",
        "512M (Recommended)",
        "1G"
      ]
    },
    {
      "name": "php_upload_max",
      "label": "MAX UPLOAD SIZE",
      "type": "select",
      "required": true,
      "no_blank": true,
      "help": "Sets the maximum file size for uploads (Critical for CMS).",
      "choices": [
        "32M",
        "64M (Recommended)",
        "128M"
      ]
    },
    {
      "name": "php_version",
      "label": "PHP VERSION",
      "type": "select",
      "required": true,
      "no_blank": true,
      "default": "8.3 (Recommended)",
      "choices": [
        "8.3 (Recommended)",
        "8.4"
      ]
    },
    {
      "name": "plan",
      "label": "PLAN",
      "type": "select",
      "required": true
    },
    {
      "name": "resourcepool",
      "label": "RESOURCE POOL",
      "type": "resourcePool",
      "required": true
    },
    {
      "name": "securitygroups",
      "label": "SECURITY GROUP(s)",
      "type": "secGroup"
    },
    {
      "name": "volumes",
      "label": "VOLUMES",
      "type": "diskManager",
      "required": true
    },
    {
      "name": "webServerPort",
      "label": "WEB SERVER PORT",
      "type": "number",
      "example": "80",
      "help": "Site will be reachable on your specified port, 80 is default"
    },
    {
      "name": "webserver_type",
      "label": "WEB SERVER TYPE",
      "type": "select",
      "required": true,
      "no_blank": true,
      "choices": [
        "Apache",
        "Nginx"
      ]
    }
  ]
}
