variable "mtncloud_url" {
  description = "The URL of the Moprheus platform"
  type        = string
}

variable "mtncloud_username" {
  description = "The username of the user account used to access the MTN Cloud platform"
  type        = string
}

variable "mtncloud_password" {
  description = "The password of the user account used to access the MTN Cloud platform"
  type        = string
}
